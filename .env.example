DATABASE_URL=sqlite:////tmp/roboticxs.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_WEBHOOK_URL=https://robot.example/api/telegram/runtime/webhook
ROBOTICXS_RUNTIME_MODE=pilot
ROBOTICXS_ROBOT_ID=robbie-pilot
ROBOTICXS_OWNER_ID=
ROBOTICXS_OWNER_DISPLAY_NAME=
ROBOTICXS_LOCAL_STATE_DIR=/var/lib/roboticxs
ROBOTICXS_PROVIDER=openai
ROBOTICXS_MODEL=gpt-4o-mini-or-equivalent
ROBOTICXS_ROUTING_MODE=economy
ROBOTICXS_CONVERSATION_ENABLED=false
ROBOTICXS_CONVERSATION_MODEL=qwen3:8b
ROBOTICXS_CONVERSATION_BASE_URL=http://127.0.0.1:11434
ROBOTICXS_CONVERSATION_TIMEOUT_SECONDS=8
ROBOTICXS_CONVERSATION_HISTORY_ENABLED=false
ROBOTICXS_CONVERSATION_HISTORY_MAX_TURNS=6
ROBOTICXS_CONVERSATION_HISTORY_TTL_MINUTES=120
